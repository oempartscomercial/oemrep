generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Parametro {
  chave String @id
  valor String
}

enum PerfilUsuario {
  OPERADOR
  ANALISTA
  ADMIN
}

enum TipoConfirmacaoEstoque {
  AUTOMATICA
  PRESUMIDA
}

model Fabrica {
  id               String             @id @default(cuid())
  nome             String
  cnpj             String             @unique
  flagConciliacao  Boolean            @default(false)
  // Fábrica desativada some dos formulários; histórico e pedidos continuam.
  ativo            Boolean            @default(true)
  criadoEm         DateTime           @default(now())
  clientes         ClienteFabrica[]
  usuarios         UsuarioFabrica[]
  pedidos          Pedido[]
  historicoMensal  HistoricoMensal[]
  pedidosHistorico PedidoHistorico[]
  oportunidades    Oportunidade[]
  importacoes      ImportacaoPedido[]
}

// Cadastro único de empresa: clientes e prospecção (ADR-013). As telas dizem "Empresas".
// CNPJ é opcional (prospecção chega sem ele), mas pedido e NFe exigem cliente com CNPJ.
enum SituacaoEmpresa {
  CANDIDATA
  APROVADA
  EM_CONTATO
  CONVERSANDO
  AVANCO
  PAUSADA
  DESCARTADA
  CLIENTE
}

model Cliente {
  id               String             @id @default(cuid())
  cnpj             String?            @unique
  nomeFantasia     String
  situacao         SituacaoEmpresa    @default(CLIENTE)
  cidade           String?
  uf               String?
  site             String?
  grupo            String?
  origem           String?
  observacoes      String?
  naoContatar      Boolean            @default(false)
  criadoEm         DateTime           @default(now())
  fabricas         ClienteFabrica[]
  pedidos          Pedido[]
  contatos         Contato[]
  interacoes       Interacao[]
  proximosPassos   ProximoPasso[]
  pedidosHistorico PedidoHistorico[]
  oportunidades    Oportunidade[]
  conversas        Conversa[]
  importacoes      ImportacaoPedido[]
}

model ClienteFabrica {
  id                     String                 @id @default(cuid())
  clienteId              String
  fabricaId              String
  flagAcessoSistema      Boolean                @default(false)
  tipoConfirmacaoEstoque TipoConfirmacaoEstoque @default(PRESUMIDA)
  cliente                Cliente                @relation(fields: [clienteId], references: [id])
  fabrica                Fabrica                @relation(fields: [fabricaId], references: [id])

  @@unique([clienteId, fabricaId])
}

model Usuario {
  id                   String             @id @default(cuid())
  supabaseUserId       String?            @unique // vínculo ao login Supabase no 1º acesso (ADR-010)
  nome                 String
  email                String             @unique
  perfil               PerfilUsuario      @default(OPERADOR)
  // Usuário desativado não entra mais (obterUsuarioLogado devolve null).
  ativo                Boolean            @default(true)
  criadoEm             DateTime           @default(now())
  fabricas             UsuarioFabrica[]
  eventos              EventoAuditoria[]
  eventosRastreio      EventoRastreio[]
  chamadosAbertos      Chamado[]          @relation("ChamadoAbertoPor")
  eventosChamado       EventoChamado[]
  interacoes           Interacao[]
  proximosPassos       ProximoPasso[]
  oportunidadesCriadas Oportunidade[]
  mensagensCriadas     Mensagem[]         @relation("MensagemCriadaPor")
  mensagensAprovadas   Mensagem[]         @relation("MensagemAprovadaPor")
  arquivosEnviados     ArquivoImportado[]
  importacoesPedido    ImportacaoPedido[]
}

model UsuarioFabrica {
  id        String  @id @default(cuid())
  usuarioId String
  fabricaId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  fabrica   Fabrica @relation(fields: [fabricaId], references: [id])

  @@unique([usuarioId, fabricaId])
}

model EventoAuditoria {
  id            String   @id @default(cuid())
  entidade      String
  entidadeId    String
  campo         String
  valorAnterior String?
  valorNovo     String?
  usuarioId     String
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  criadoEm      DateTime @default(now())

  @@index([entidade, entidadeId])
}

enum EstadoPedido {
  SEM_NFE
  PARCIAL
  COMPLETO
  ARQUIVADO
}

enum OrigemPedido {
  EXCEL
  MANUAL
  PDF
  // Registro rápido sem itens: o pedido chegou como print de WhatsApp ou recado de
  // vendedor, só com cliente e valor. Os itens entram depois (PDF ou nota) ou nunca.
  RAPIDO
}

enum EstadoImportacao {
  EXTRAINDO
  AGUARDANDO_REVISAO
  CONFIRMADA
  DESCARTADA
  FALHOU
}

enum StatusItemPedido {
  PENDENTE
  OK
  FORA_DE_FABRICACAO
  DESISTENCIA
}

model Pedido {
  id              String             @id @default(cuid())
  numero          String?
  semNumero       Boolean            @default(false)
  origem          OrigemPedido
  estado          EstadoPedido       @default(SEM_NFE)
  fabricaId       String
  clienteId       String
  fabrica         Fabrica            @relation(fields: [fabricaId], references: [id])
  cliente         Cliente            @relation(fields: [clienteId], references: [id])
  itens           ItemPedido[]
  notasFiscais    NotaFiscalPedido[]
  arquivoOrigemId String?
  arquivoOrigem   ArquivoImportado?  @relation(fields: [arquivoOrigemId], references: [id])
  importacao      ImportacaoPedido?
  criadoEm        DateTime           @default(now())

  // Número que o CLIENTE dá ao pedido (ordem de compra). Diferente do número da fábrica:
  // a NFe cita este no xPed/infCpl, e é por ele que a nota acha o pedido sozinha.
  numeroCliente         String?
  // Data em que o pedido foi feito; criadoEm é quando entrou no sistema.
  dataPedido            DateTime?
  // Valor total informado no registro (pedido rápido) ou impresso no PDF. Para pedido com
  // itens, o valor de referência continua sendo a soma dos itens.
  valorTotalDeclarado   Decimal?  @db.Decimal(12, 2)
  observacao            String?
  // Do PDF do pedido (Bling): quem vai levar e em que modalidade. Texto como impresso.
  transportadorPrevisto String?
  modalidadeFrete       String?
  vendedor              String?

  // Reimportar o mesmo arquivo por engano criava um segundo pedido idêntico, que ficava
  // SEM_NFE para sempre inflando os alertas e dobrando o valor no painel de gap. Número
  // nulo (S/N) não colide: o Postgres trata NULLs como distintos.
  @@unique([fabricaId, clienteId, numero])
  @@index([fabricaId])
  @@index([clienteId])
  @@index([estado])
  @@index([criadoEm])
  @@index([arquivoOrigemId])
  @@index([numeroCliente])
}

model ItemPedido {
  id                 String @id @default(cuid())
  pedidoId           String
  pedido             Pedido @relation(fields: [pedidoId], references: [id])
  referencia         String
  descricao          String
  quantidadePedida   Int
  quantidadeFaturada Int    @default(0)

  // Quatro casas, não duas: o pedido de venda da Bowden imprime valor unitário com quatro
  // decimais (205,5690). Truncado em centavos, uma linha de 40 unidades erra R$ 0,04 — e
  // esse valor errado é o que a conferência compara contra o vUnCom da NFe.
  valorUnitario Decimal @db.Decimal(12, 4)

  status               StatusItemPedido @default(PENDENTE)
  observacao           String?
  qtdPendenteCongelada Int?
  itensFaturados       ItemFaturado[]
  criadoEm             DateTime         @default(now())
  chamadoItens         ChamadoItem[]

  @@index([pedidoId])
  @@index([referencia])
  @@index([status])
}

enum StatusRastreio {
  TRANSITO
  // A transportadora marcou data de entrega com o cliente (a planilha do Zé usa).
  AGENDADO
  RECEBIDA
  ARMAZENADA
  EXTRAVIADO
}

// Como o sistema consulta o rastreio de uma transportadora.
enum MetodoRastreio {
  // API pública do SSW por chave da NFe (POST ssw.inf.br/api/trackingdanfe).
  SSW
  // Sem rastreio público: o operador pergunta e atualiza à mão.
  MANUAL
  // Apareceu numa nota e ainda ninguém descobriu como rastrear.
  NAO_MAPEADA
}

enum OrigemEventoRastreio {
  MANUAL
  AUTOMATICO
}

/**
 * Transportadora que leva as notas. Nasce sozinha na conferência, pelo <transporta> do XML
 * da NFe, como NAO_MAPEADA; a primeira consulta SSW que responder promove para SSW.
 */
model Transportadora {
  id                    String         @id @default(cuid())
  cnpj                  String         @unique
  nome                  String
  metodo                MetodoRastreio @default(NAO_MAPEADA)
  urlPublica            String?
  contato               String?
  observacao            String?
  criadaAutomaticamente Boolean        @default(true)
  ultimaConsultaEm      DateTime?
  ultimaConsultaOk      DateTime?
  falhasSeguidas        Int            @default(0)
  // Issue aberta no GitHub pedindo a integração (uma por transportadora).
  issueUrl              String?
  criadoEm              DateTime       @default(now())
  notasFiscais          NotaFiscal[]
}

model NotaFiscal {
  id               String         @id @default(cuid())
  numero           String
  chaveAcesso      String         @unique
  emitenteCnpj     String
  destinatarioCnpj String
  dataEmissao      DateTime
  totalProdutos    Decimal        @db.Decimal(12, 2)
  totalNota        Decimal        @db.Decimal(12, 2)
  status           StatusRastreio @default(TRANSITO)
  criadoEm         DateTime       @default(now())

  // Transporte, lido do <transp> do XML.
  transportadoraId String?
  transportadora   Transportadora? @relation(fields: [transportadoraId], references: [id])
  modalidadeFrete  String?
  volumes          Int?
  pesoBruto        Decimal?        @db.Decimal(12, 3)

  // Rastreio automático: o resumo do que a transportadora disse por último.
  previsaoEntrega      DateTime?
  ultimaOcorrencia     String?
  ultimaOcorrenciaEm   DateTime?
  rastreioAtualizadoEm DateTime?
  rastreioFalhas       Int       @default(0)

  pedidos         NotaFiscalPedido[]
  itensFaturados  ItemFaturado[]
  eventosRastreio EventoRastreio[]
  chamados        Chamado[]

  @@index([transportadoraId])
  @@index([status])
}

model NotaFiscalPedido {
  id           String     @id @default(cuid())
  notaFiscalId String
  pedidoId     String
  notaFiscal   NotaFiscal @relation(fields: [notaFiscalId], references: [id])
  pedido       Pedido     @relation(fields: [pedidoId], references: [id])

  @@unique([notaFiscalId, pedidoId])
}

model ItemFaturado {
  id                 String @id @default(cuid())
  itemPedidoId       String
  notaFiscalId       String
  quantidadeFaturada Int

  // O preço REALMENTE faturado, que antes não era gravado em lugar nenhum. Sem ele o painel
  // de gap valorizava o faturado pelo preço do pedido: a fábrica faturava mais caro, o
  // operador aceitava a divergência, e o gap aparecia R$ 0,00 — mascarando exatamente o
  // sobrefaturamento que o painel existe para achar.
  valorUnitario Decimal @db.Decimal(12, 4)

  criadoEm   DateTime   @default(now())
  itemPedido ItemPedido @relation(fields: [itemPedidoId], references: [id])
  notaFiscal NotaFiscal @relation(fields: [notaFiscalId], references: [id])

  // Uma linha por par item×nota: defesa de banco contra a baixa dobrada que o .find() da
  // conferência permitia quando a NFe repetia o mesmo código em duas linhas.
  @@unique([itemPedidoId, notaFiscalId])
  @@index([notaFiscalId])
}

/**
 * O documento que originou uma importação, guardado para conferência.
 * Separado de Pedido porque o arquivo existe ANTES do pedido — durante a extração e a
 * revisão, quando pedido ainda não há — e porque um PDF pode gerar mais de um pedido.
 */
model ArquivoImportado {
  id             String   @id @default(cuid())
  nomeOriginal   String
  caminhoStorage String   @unique
  tamanhoBytes   Int
  mimeType       String
  enviadoPorId   String
  enviadoPor     Usuario  @relation(fields: [enviadoPorId], references: [id])
  criadoEm       DateTime @default(now())

  importacoes ImportacaoPedido[]
  pedidos     Pedido[]

  @@index([enviadoPorId])
}

/**
 * Rascunho durável de uma importação por PDF.
 * Antes as linhas extraídas viviam só em estado React: um F5 no meio da revisão perdia
 * tudo. Com Excel isso custava um reupload de dois segundos; com PDF custa uma extração
 * já paga, e a revisão é mais longa porque há mais campo para conferir.
 * As duas colunas Json são de propósito: `extracaoBruta` é o que a leitura devolveu,
 * imutável — é a evidência de auditoria e a base para medir a acurácia real ao longo do
 * tempo; `revisaoAtual` é o que o operador está editando. Guardar as duas responde
 * "o que o sistema leu vs. o que o humano corrigiu".
 */
model ImportacaoPedido {
  id            String            @id @default(cuid())
  // Anulável: quando o armazenamento de arquivo não está configurado, a importação roda
  // e cria o pedido sem reter o PDF — o documento-fonte é guardado só quando dá.
  arquivoId     String?
  arquivo       ArquivoImportado? @relation(fields: [arquivoId], references: [id])
  estado        EstadoImportacao  @default(EXTRAINDO)
  extracaoBruta Json?
  revisaoAtual  Json?
  erro          String?
  fabricaId     String?
  fabrica       Fabrica?          @relation(fields: [fabricaId], references: [id])
  clienteId     String?
  cliente       Cliente?          @relation(fields: [clienteId], references: [id])
  pedidoId      String?           @unique
  pedido        Pedido?           @relation(fields: [pedidoId], references: [id])
  criadoPorId   String
  criadoPor     Usuario           @relation(fields: [criadoPorId], references: [id])
  criadoEm      DateTime          @default(now())
  atualizadoEm  DateTime          @updatedAt

  @@index([arquivoId])
  @@index([estado])
  @@index([criadoPorId])
}

model EventoRastreio {
  id             String               @id @default(cuid())
  notaFiscalId   String
  notaFiscal     NotaFiscal           @relation(fields: [notaFiscalId], references: [id])
  statusAnterior StatusRastreio
  status         StatusRastreio
  observacao     String?
  dataEvento     DateTime
  // Nulo quando o evento veio da consulta automática à transportadora.
  usuarioId      String?
  usuario        Usuario?             @relation(fields: [usuarioId], references: [id])
  origem         OrigemEventoRastreio @default(MANUAL)
  local          String?
  criadoEm       DateTime             @default(now())

  @@index([notaFiscalId])
}

model MotivoChamado {
  id       String    @id @default(cuid())
  nome     String    @unique
  chamados Chamado[]
}

enum EstadoChamado {
  ABERTO
  EM_TRATATIVA
  AGUARDANDO
  RESOLVIDO
}

model Chamado {
  id            String          @id @default(cuid())
  notaFiscalId  String
  notaFiscal    NotaFiscal      @relation(fields: [notaFiscalId], references: [id])
  motivoId      String
  motivo        MotivoChamado   @relation(fields: [motivoId], references: [id])
  estado        EstadoChamado   @default(ABERTO)
  abertoPorId   String
  abertoPor     Usuario         @relation("ChamadoAbertoPor", fields: [abertoPorId], references: [id])
  itensAfetados ChamadoItem[]
  eventos       EventoChamado[]
  criadoEm      DateTime        @default(now())

  @@index([notaFiscalId])
}

model ChamadoItem {
  id           String     @id @default(cuid())
  chamadoId    String
  chamado      Chamado    @relation(fields: [chamadoId], references: [id])
  itemPedidoId String
  itemPedido   ItemPedido @relation(fields: [itemPedidoId], references: [id])

  @@unique([chamadoId, itemPedidoId])
}

model EventoChamado {
  id             String         @id @default(cuid())
  chamadoId      String
  chamado        Chamado        @relation(fields: [chamadoId], references: [id])
  estadoAnterior EstadoChamado?
  estado         EstadoChamado
  observacao     String
  usuarioId      String
  usuario        Usuario        @relation(fields: [usuarioId], references: [id])
  criadoEm       DateTime       @default(now())

  @@index([chamadoId])
}

enum TipoHistoricoMensal {
  PEDIDO
  NFE
}

model HistoricoMensal {
  id        String              @id @default(cuid())
  ano       Int
  mes       Int
  fabricaId String
  fabrica   Fabrica             @relation(fields: [fabricaId], references: [id])
  tipo      TipoHistoricoMensal
  valor     Decimal             @db.Decimal(14, 2)
  criadoEm  DateTime            @default(now())

  @@unique([ano, mes, fabricaId, tipo])
}

// ---------------------------------------------------------------------------
// CRM (ADR-013)
// ---------------------------------------------------------------------------

enum CanalContato {
  WHATSAPP
  TELEFONE
  EMAIL
  LINKEDIN
  OUTRO
}

// Pessoa ou canal de uma empresa. Todo contato tem fonte: de onde veio o dado.
model Contato {
  id            String         @id @default(cuid())
  clienteId     String
  cliente       Cliente        @relation(fields: [clienteId], references: [id])
  nome          String?
  funcao        String?
  canal         CanalContato
  valor         String
  servePara     String?
  status        String?
  fonte         String
  verificadoEm  DateTime?
  naoContatar   Boolean        @default(false)
  observacoes   String?
  // De onde veio o número (ADR-015 §4). Sem origem registrada, nenhuma mensagem é enviada.
  origemContato OrigemContato?
  criadoEm      DateTime       @default(now())
  conversas     Conversa[]

  @@index([clienteId])
}

enum CanalInteracao {
  WHATSAPP
  TELEFONE
  EMAIL
  VISITA
  REUNIAO
  PESQUISA
  OUTRO
}

enum OrigemInteracao {
  USUARIO
  AUTOMACAO
  IMPORTACAO
}

// Linha do tempo da empresa: o que aconteceu, com quem e por qual canal.
model Interacao {
  id             String          @id @default(cuid())
  clienteId      String
  cliente        Cliente         @relation(fields: [clienteId], references: [id])
  data           DateTime
  canal          CanalInteracao
  comQuem        String?
  resumo         String
  resultado      String?
  origem         OrigemInteracao @default(USUARIO)
  usuarioId      String?
  usuario        Usuario?        @relation(fields: [usuarioId], references: [id])
  oportunidadeId String?
  oportunidade   Oportunidade?   @relation(fields: [oportunidadeId], references: [id])
  criadoEm       DateTime        @default(now())

  @@index([clienteId, data])
}

// Empresa em situação ativa (APROVADA a AVANCO) tem sempre um próximo passo aberto.
model ProximoPasso {
  id             String        @id @default(cuid())
  clienteId      String
  cliente        Cliente       @relation(fields: [clienteId], references: [id])
  acao           String
  prazo          DateTime      @db.Date
  responsavelId  String
  responsavel    Usuario       @relation(fields: [responsavelId], references: [id])
  // Preenchido quando o passo é de uma oportunidade da carteira; vazio = passo da empresa (prospecção).
  oportunidadeId String?
  oportunidade   Oportunidade? @relation(fields: [oportunidadeId], references: [id])
  concluidoEm    DateTime?
  criadoEm       DateTime      @default(now())

  @@index([clienteId, concluidoEm])
  @@index([responsavelId, prazo])
}

enum TipoPedidoHistorico {
  PEDIDO
  BONIFICACAO
}

// Pedidos anteriores ao sistema, por cliente (ADR-013, revê ADR-012 nesse ponto).
// Sem item, quantidade ou NFe: só o que a planilha de pedidos recebidos tem.
model PedidoHistorico {
  id                  String              @id @default(cuid())
  data                DateTime            @db.Date
  dataSoMes           Boolean             @default(false)
  clienteId           String
  cliente             Cliente             @relation(fields: [clienteId], references: [id])
  fabricaId           String
  fabrica             Fabrica             @relation(fields: [fabricaId], references: [id])
  valor               Decimal             @db.Decimal(14, 2)
  tipo                TipoPedidoHistorico @default(PEDIDO)
  rotuloPlanilha      String
  linhaPlanilha       Int                 @unique
  suspeitaDuplicidade Boolean             @default(false)
  alerta              String?
  criadoEm            DateTime            @default(now())

  @@index([clienteId, data])
}

enum EtapaOportunidade {
  A_ABORDAR
  ABORDADO
  INTERESSE
  COTACAO
  GANHA
  ADIADA
  PERDIDA
}

enum TipoOportunidade {
  VENDER_FABRICA_NOVA
  REATIVAR
}

// Funil da carteira (ADR-013): um cliente + uma fábrica. Fica GANHA sozinha quando chega
// pedido desse cliente nessa fábrica. Só existe para empresas já clientes.
model Oportunidade {
  id             String            @id @default(cuid())
  clienteId      String
  cliente        Cliente           @relation(fields: [clienteId], references: [id])
  fabricaId      String
  fabrica        Fabrica           @relation(fields: [fabricaId], references: [id])
  tipo           TipoOportunidade
  etapa          EtapaOportunidade @default(A_ABORDAR)
  motivoPerda    String?
  observacoes    String?
  criadoPorId    String?
  criadoPor      Usuario?          @relation(fields: [criadoPorId], references: [id])
  criadoEm       DateTime          @default(now())
  encerradaEm    DateTime?
  proximosPassos ProximoPasso[]
  interacoes     Interacao[]

  @@index([clienteId, fabricaId])
  @@index([etapa])
}

enum OrigemContato {
  PUBLICADO_PELA_EMPRESA
  INDICACAO
  BASE_PROFISSIONAL
  RELACIONAMENTO
}

// WhatsApp (ADR-015, fase 1: só registro). Cada linha é um número da OEM: a de prospecção
// fala com empresas; a do assistente (fase 3) fala com o Rômulo.
enum LinhaWhatsapp {
  PROSPECCAO
  ASSISTENTE
}

enum DirecaoMensagem {
  ENTRADA
  SAIDA
}

enum OrigemMensagem {
  CONTATO
  ROMULO_NO_CELULAR
  PLATAFORMA
  ASSISTENTE
}

enum TipoMensagem {
  TEXTO
  AUDIO
  IMAGEM
  VIDEO
  DOCUMENTO
  OUTRO
}

// O que o transporte entregou, exatamente como chegou. Grava-se antes de qualquer leitura:
// se o formato mudar ou o processamento falhar, o evento pode ser reprocessado.
model EventoWhatsapp {
  id           String        @id @default(cuid())
  linha        LinhaWhatsapp
  payload      Json
  recebidoEm   DateTime      @default(now())
  processadoEm DateTime?
  // "mensagem", "duplicada", "ignorado: ...", "sem_numero: ..." ou "erro: ..."
  resultado    String?
  mensagens    Mensagem[]

  @@index([linha, recebidoEm])
}

// Um número numa linha. clienteId nulo = número que não casou com nenhum contato
// (ou que casou com mais de uma empresa): fica na lista "sem identificar".
model Conversa {
  id               String        @id @default(cuid())
  linha            LinhaWhatsapp
  numero           String
  clienteId        String?
  cliente          Cliente?      @relation(fields: [clienteId], references: [id])
  contatoId        String?
  contato          Contato?      @relation(fields: [contatoId], references: [id])
  motivoSemVinculo String?
  nomeNoWhatsapp   String?
  ultimaMensagemEm DateTime
  criadoEm         DateTime      @default(now())
  mensagens        Mensagem[]

  @@unique([linha, numero])
  @@index([clienteId])
  @@index([ultimaMensagemEm])
}

// Ciclo da mensagem de saída: RASCUNHO → APROVADA → ENVIANDO → ENVIADA → ENTREGUE → LIDA,
// com FALHOU e CANCELADA. Mensagem recebida nasce RECEBIDA.
enum StatusMensagem {
  RECEBIDA
  RASCUNHO
  APROVADA
  ENVIANDO
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU
  CANCELADA
}

enum TipoEnvio {
  PRIMEIRO_CONTATO
  FOLLOW_UP
  RESPOSTA
}

enum ClassificacaoMensagem {
  INTERESSE
  PERGUNTA_OBJECAO
  NAO_INTERESSADO
  NAO_CONTATAR
  AMBIGUA
}

enum OrigemClassificacao {
  REGRA
  PESSOA
  IA
}

model Mensagem {
  id         String          @id @default(cuid())
  conversaId String
  conversa   Conversa        @relation(fields: [conversaId], references: [id])
  linha      LinhaWhatsapp
  // Rascunho ainda não tem id do WhatsApp; ganha ao ser enviado.
  idExterno  String?
  direcao    DirecaoMensagem
  origem     OrigemMensagem
  tipo       TipoMensagem
  texto      String?
  ocorridoEm DateTime
  eventoId   String?
  evento     EventoWhatsapp? @relation(fields: [eventoId], references: [id])
  criadoEm   DateTime        @default(now())

  status              StatusMensagem         @default(RECEBIDA)
  tipoEnvio           TipoEnvio?
  geradaPorIa         Boolean                @default(false)
  criadaPorId         String?
  criadaPor           Usuario?               @relation("MensagemCriadaPor", fields: [criadaPorId], references: [id])
  aprovadaPorId       String?
  aprovadaPor         Usuario?               @relation("MensagemAprovadaPor", fields: [aprovadaPorId], references: [id])
  aprovadaEm          DateTime?
  enviadaEm           DateTime?
  erro                String?
  // Por que a mensagem aprovada ainda não saiu (fora do horário, linha caída...).
  motivoBloqueio      String?
  classificacao       ClassificacaoMensagem?
  classificacaoOrigem OrigemClassificacao?

  // O mesmo evento pode chegar mais de uma vez: o id do WhatsApp evita a duplicata.
  @@unique([linha, idExterno])
  @@index([conversaId, ocorridoEm])
}
