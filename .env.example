DATABASE_URL="postgresql://USER:PASS@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASS@HOST:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Só para desenvolvimento local: navega sem login assumindo a identidade de um
# usuário já cadastrado na tabela Usuario (escopo por fábrica e auditoria seguem
# valendo). Os dois são obrigatórios — sem SKIP_AUTH_EMAIL não há sessão.
# Nunca ativa com NODE_ENV=production, então não tem efeito na Vercel.
SKIP_AUTH="false"
SKIP_AUTH_EMAIL=""

# Webhook do WhatsApp (ADR-015). Um segredo por linha, com 16+ caracteres (gere com
# `openssl rand -hex 24`). O transporte (Evolution) o envia no cabeçalho x-webhook-secret
# ou em ?segredo= na URL: POST /api/whatsapp/prospeccao/webhook. Sem o segredo, a rota
# responde 503 e não grava nada.
WHATSAPP_WEBHOOK_SEGREDO_PROSPECCAO=""

# Cron de envio agendado do WhatsApp (ADR-015 §4): reenvia as mensagens aprovadas que
# ficaram esperando (fora do horário, linha caída, limite do dia). Rota: GET /api/cron/whatsapp,
# chamada pela Vercel com `Authorization: Bearer <CRON_SECRET>` (ver vercel.json). Mínimo 16
# caracteres; gere com `openssl rand -hex 24`. Sem ele, a rota responde 503 e nada é enviado.
# CRON_SECRET=""

# Convites por e-mail (Cadastros > Usuários). Só servidor, nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Opcional: endereço público do app para os links dos e-mails. Sem ele vale o host da requisição.
# NEXT_PUBLIC_SITE_URL="https://oem-rep.vercel.app"

# Importação de pedido por PDF:
# - a leitura da camada de texto do PDF funciona SEM a chave da Anthropic.
# - o PDF original é guardado no Storage do Supabase com a SUPABASE_SERVICE_ROLE_KEY acima.
# - chave da API da Anthropic, opcional, para a leitura por IA (PDF escaneado / outro layout)
# ANTHROPIC_API_KEY="sk-ant-..."
# - modelo usado na leitura por IA; troque para baixar o custo
# ANTHROPIC_MODEL="claude-opus-5"
