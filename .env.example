DATABASE_URL="postgresql://USER:PASS@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASS@HOST:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Só para desenvolvimento local: navega sem login assumindo a identidade de um
# usuário já cadastrado na tabela Usuario (escopo por fábrica e auditoria seguem
# valendo). Os dois são obrigatórios — sem SKIP_AUTH_EMAIL não há sessão.
# Nunca ativa com NODE_ENV=production, então não tem efeito na Vercel.
SKIP_AUTH="false"
SKIP_AUTH_EMAIL=""

# Chave que cifra os segredos da tela Administração > Integrações (chave da Evolution, token do
# Chatwoot, segredo do webhook) — ADR-019. 32 bytes em hex (64 caracteres) ou base64; gere com
# `openssl rand -hex 32`. Sem ela, a tela explica e não salva. Trocar a chave invalida o que está
# salvo (é preciso colar os segredos de novo na tela). Nunca com prefixo NEXT_PUBLIC_.
# INTEGRACOES_CHAVE=""

# Webhook do WhatsApp (ADR-015). Opcional desde o ADR-019: o botão "Configurar webhook" da tela
# de Integrações gera e guarda um segredo no banco. Este continua aceito (16+ caracteres, gere com
# `openssl rand -hex 24`), no cabeçalho x-webhook-secret ou em ?segredo= na URL:
# POST /api/whatsapp/prospeccao/webhook. Sem nenhum dos dois, a rota responde 503 e não grava nada.
WHATSAPP_WEBHOOK_SEGREDO_PROSPECCAO=""

# Cron de envio agendado do WhatsApp (ADR-015 §4): reenvia as mensagens aprovadas que
# ficaram esperando (fora do horário, linha caída, limite do dia). Rota: GET /api/cron/whatsapp,
# chamada pela Vercel 1x/dia e pelo Supabase a cada 5 min (pg_cron, SQL no ADR-019) com
# `Authorization: Bearer <CRON_SECRET>`. Mínimo 16 caracteres; gere com `openssl rand -hex 24`.
# Sem ele, a rota responde 503 e nada é enviado.
# CRON_SECRET=""
# O mesmo segredo vale para GET /api/cron/rastreio (diário): consulta as transportadoras das
# notas em trânsito pelo SSW.

# Issue automática de transportadora nova sem rastreio (cron de rastreio). Token do GitHub com
# permissão de escrever issues no repositório. Sem ele, o cron só não abre a issue.
# GITHUB_TOKEN=""
# GITHUB_REPO="arthur7114/oem-rep"

# Convites por e-mail (Cadastros > Usuários). Só servidor, nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Endereço público do app: links dos e-mails e URL do webhook que a tela de Integrações grava na
# Evolution. Sem ele vale o host da requisição (a tela recusa localhost para o webhook).
# NEXT_PUBLIC_SITE_URL="https://oem-rep.vercel.app"

# Importação de pedido por PDF:
# - a leitura da camada de texto do PDF funciona SEM a chave da Anthropic.
# - o PDF original é guardado no Storage do Supabase com a SUPABASE_SERVICE_ROLE_KEY acima.
# - chave da API da Anthropic, opcional, para a leitura por IA (PDF escaneado / outro layout)
# ANTHROPIC_API_KEY="sk-ant-..."
# - modelo usado na leitura por IA; troque para baixar o custo
# ANTHROPIC_MODEL="claude-opus-5"
